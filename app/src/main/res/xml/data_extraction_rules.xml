<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Same excludes for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
        <exclude domain="device_root" path="app_webview" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCookiesChromium.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
        <exclude domain="device_root" path="app_webview" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCookiesChromium.db" />
    </device-transfer>
</data-extraction-rules>
